{
  "profile": "Braseiro Actual Play Director",
  "version": 1,
  "sources_summarized": ["D&D actual plays", "Forbidden Lands actual plays", "O Um Anel actual plays", "Traveller actual plays", "GURPS actual plays"],
  "directives": {
    "scene_layers": ["panorama", "approach", "landmark", "threshold", "decision"],
    "compress_routine": true,
    "world_already_moving": true,
    "npc_has_current_activity": true,
    "dialogue_beats_paragraphs": [1, 3],
    "avoid_npc_monologues": true,
    "answer_all_relevant_questions": true,
    "checks_only_for_meaningful_uncertainty": true,
    "basic_conversation_needs_no_social_check": true,
    "failure_mode": ["cost", "exposure", "time", "position", "complication"],
    "essential_clue_never_single_roll_gate": true,
    "travel_loop": ["procedure", "relevant_result", "consequence", "new_decision"],
    "combat_description": ["threat", "movement", "trajectory", "contact", "result", "consequence"],
    "rules_outside_narrative": true,
    "tts_only_narrative_and_dialogue": true,
    "memory_truth_separate_from_presentation": true,
    "end_scene_on_meaningful_decision": true
  }
}
